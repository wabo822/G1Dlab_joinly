server {
    listen 80;
    listen [::]:80;
    server_name isep.wangjiahan.com;
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / {
        return 301 https://isep.wangjiahan.com$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name isep.wangjiahan.com;
    ssl_certificate /etc/letsencrypt/live/isep.wangjiahan.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/isep.wangjiahan.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    client_max_body_size 3m;

    location ~ /\.(?!well-known) {
        deny all;
    }
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
    }
}
