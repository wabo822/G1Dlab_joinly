# Server-side only. Copy to .env and supply the locally generated password.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=joinly
PGUSER=joinly_app
PGPASSWORD=replace-with-local-password
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=replace-with-a-long-random-secret
# Use 1 for HTTPS; 0 is only for local HTTP development / SSH tunnels.
COOKIE_SECURE=0
# Optional password-reset mail transport. No mail is sent until configured.
# PUBLIC_BASE_URL=https://joinly.example.org
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
