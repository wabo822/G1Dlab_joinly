# Server-side only. Copy to .env and supply the locally generated password.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=joinly
PGUSER=joinly_app
PGPASSWORD=replace-with-local-password
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=replace-with-a-long-random-secret
# Use 1 for HTTPS; 0 is only for local HTTP development / SSH tunnels.
COOKIE_SECURE=0
# Public origin, no trailing slash. Used for password-reset links, canonical URLs,
# Open Graph tags and sitemap.xml. Example for the current deployment:
# PUBLIC_BASE_URL=https://isep.wangjiahan.com
# Optional password-reset mail transport. No mail is sent until configured.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=

# Minutes before the start when booking closes. 0 closes bookings at the start.
# The activity becomes "Terminé" when its end time has passed (Europe/Paris). No cron.
BOOKING_CUTOFF_MINUTES=0

# Only enable behind the trusted local reverse proxy.
TRUST_PROXY=0
# TRUSTED_HOSTS=isep.wangjiahan.com,127.0.0.1,localhost
